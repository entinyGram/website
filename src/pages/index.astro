---
import Layout from "../layouts/Layout.astro";
import EntinyGramHeader from "../components/Header.astro";
import EntinyGramFooter from "../components/Footer.astro";
import { getLatestEntinyRelease } from "../lib/entinygram";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=120, s-maxage=600, stale-while-revalidate=86400"
);

const latestRelease = await getLatestEntinyRelease();
const releasesError = !latestRelease;
const apk = latestRelease?.assets.find((asset) => asset.name.endsWith(".apk"));
const downloadUrl = apk?.browser_download_url ?? latestRelease?.html_url ?? "https://github.com/entaytion/entinyGram/releases";
const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const description = pageLang === "uk"
  ? "Кастомний патчсет для Telegram Android на базі InuGram. Налаштуй інтерфейс, отримуй свіжі релізи та переглядай відкритий код."
  : "A customizable Telegram Android patchset built on InuGram. Tune the interface, get fresh releases, and explore the open source code.";

const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "entinyGram",
  description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: "Android",
  url: "https://entiny.tech",
  image: "https://entiny.tech/og/entinygram-banner.png",
  downloadUrl: "https://github.com/entaytion/entinyGram/releases",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout
  title="entinyGram — Telegram Android, your way"
  description={description}
  favicon="/favicon.svg"
  image="/og/entinygram-banner.png"
  lang={pageLang}
  jsonLd={applicationJsonLd}
>
  <div class="eg-page" id="entinygram-page">
    <EntinyGramHeader active="home" />

    <main>
      <section class="eg-hero" aria-labelledby="eg-title">
        <div class="eg-hero-copy">
          <h1 id="eg-title"><span data-lang-key="eg_hero_line1">Telegram,</span><br /><span class="eg-highlight" data-lang-key="eg_hero_line2">your way.</span></h1>
          <p class="eg-hero-description" data-lang-key="eg_hero_description">
            Custom-pilled patchset for Telegram Android power users. Freedom from liquid glass, bypasses, custom font stacks, and real privacy.
          </p>

          <div class="eg-hero-btns">
            <a class="eg-tech-btn eg-btn-primary" href="/downloads">
              <span class="eg-btn-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              </span>
              <span class="eg-btn-label" data-lang-key="eg_download_cta">{pageLang === "uk" ? "Завантажити" : "Download"}</span>
              <span class="eg-btn-meta">APK</span>
            </a>

            <a class="eg-tech-btn" href="https://t.me/entinyGram" target="_blank" rel="noopener noreferrer">
              <span class="eg-btn-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m22 2-7 20-4-9-9-4Z"/>
                  <path d="M22 2 11 13"/>
                </svg>
              </span>
              <span class="eg-btn-label">Telegram</span>
              <span class="eg-btn-meta">↗</span>
            </a>

            <a class="eg-tech-btn" href="https://github.com/entaytion/entinyGram" target="_blank" rel="noopener noreferrer">
              <span class="eg-btn-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                  <path d="M9 18c-4.51 2-5-2-7-2"/>
                </svg>
              </span>
              <span class="eg-btn-label">GitHub</span>
              <span class="eg-btn-meta">↗</span>
            </a>
          </div>

          <div class="eg-platform-note">
            <span class="eg-status-dot" aria-hidden="true"></span>
            <span data-lang-key="eg_android_note">Built for Telegram Android</span>
          </div>
        </div>

        <div class="eg-hero-art" aria-label="Illustration of entinyGram interface settings">
          <div class="eg-art-note eg-note-top"><span class="eg-note-dot"></span><span data-lang-key="eg_art_patchset">Your interface, tuned.</span></div>
          <div class="eg-app-window">
            <div class="eg-app-topbar">
              <span class="eg-app-menu" aria-hidden="true"><i></i><i></i><i></i></span>
              <strong>entinyGram</strong>
              <span class="eg-app-search" aria-hidden="true"></span>
            </div>
            <div class="eg-chat-preview">
              <div class="eg-chat-avatar eg-avatar-one">e</div>
              <div class="eg-chat-copy"><b>entinyGram</b><span data-lang-key="eg_preview_message">A little more yours.</span></div>
              <span class="eg-chat-time">12:48</span>
            </div>
            <div class="eg-chat-preview eg-chat-muted">
              <div class="eg-chat-avatar eg-avatar-two">i</div>
              <div class="eg-chat-copy"><b>InuGram</b><span data-lang-key="eg_preview_reply">Patchset ready to apply</span></div>
              <span class="eg-chat-time">12:42</span>
            </div>
            <div class="eg-app-tabs"><span class="eg-tab-active"></span><span></span><span></span><span></span></div>
          </div>

          <div class="eg-art-note eg-note-bottom"><span class="eg-note-check" aria-hidden="true"></span><span data-lang-key="eg_art_control">Every detail in your control</span></div>
          <span class="eg-art-shape eg-shape-one" aria-hidden="true"></span>
          <span class="eg-art-shape eg-shape-two" aria-hidden="true"></span>
        </div>
      </section>

      <section class="eg-showcase-wrap" id="features" aria-labelledby="eg-showcase-title">
        <div class="eg-showcase">
          <div class="eg-showcase-copy">
            <h2 id="eg-showcase-title" data-lang-key="eg_showcase_title">Make Telegram feel like yours.</h2>
            <p data-lang-key="eg_showcase_copy">Small details change the whole app. Shape the interface with controls inspired by Material 3.</p>
            <a class="eg-inverse-link" href="/features"><span data-lang-key="entinygram_btn_features">All Features</span><span class="eg-arrow" aria-hidden="true"></span></a>
            <div class="eg-showcase-pagination" aria-hidden="true"><span></span><span></span><span class="is-active"></span><span></span></div>
          </div>

          <div class="eg-settings-art">
            <div class="eg-settings-heading">
              <span data-lang-key="eg_settings_title">Interface</span>
              <span class="eg-settings-section" data-lang-key="eg_settings_section">Personalization</span>
            </div>
            <div class="eg-setting-range">
              <div class="eg-setting-label"><label for="avatar-radius" data-lang-key="eg_avatar_rounding">Avatar shape</label><output id="avatar-radius-value">18</output></div>
              <div class="eg-setting-label eg-setting-endpoints"><span data-lang-key="eg_shape_square">Square</span><span data-lang-key="eg_shape_round">Round</span></div>
              <md-slider id="avatar-radius" min="0" max="30" value="18" step="1" aria-label="Avatar corner radius"></md-slider>
            </div>

            <div class="eg-settings-preview is-ghost-mode" id="settings-preview">
              <div class="eg-preview-toolbar">
                <span class="eg-mini-menu" aria-hidden="true">☰</span>
                <div class="eg-preview-title">
                  <b>entinyGram</b>
                  <span class="eg-preview-monster" title="Ghost Mode Active" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 11a7 7 0 0 1 14 0v7a1.78 1.78 0 0 1-3.1 1.4a1.65 1.65 0 0 0-2.6 0a1.65 1.65 0 0 1-2.6 0a1.65 1.65 0 0 0-2.6 0A1.78 1.78 0 0 1 5 18z"/>
                      <path d="M10 10h0.01M14 10h0.01"/>
                      <path d="M10 14a3.5 3.5 0 0 0 4 0"/>
                    </svg>
                  </span>
                </div>
                <span class="eg-mini-search" aria-hidden="true"></span>
              </div>
              <div class="eg-preview-chat">
                <span class="eg-preview-avatar"></span>
                <span class="eg-preview-lines"><i></i><i></i></span>
                <span class="eg-preview-time">now</span>
              </div>
              <div class="eg-alt-tabs" aria-hidden="true"><i></i><i></i><i></i></div>
            </div>

            <div class="eg-setting-list">
              <label class="eg-setting-row" for="system-fonts">
                <span>
                  <b data-lang-key="eg_system_fonts">System fonts</b>
                  <small data-lang-key="eg_system_fonts_desc">Use your device’s font family</small>
                </span>
                <md-switch id="system-fonts" data-setting-switch="font" aria-label="Use system fonts"></md-switch>
              </label>

              <label class="eg-setting-row" for="ghost-mode">
                <span>
                  <b>Ghost Mode</b>
                  <small>{pageLang === "uk" ? "Прихований онлайн і статус «друкує…»" : "Hide online status & typing indicator"}</small>
                </span>
                <md-switch id="ghost-mode" data-setting-switch="ghost" selected aria-label="Ghost Mode"></md-switch>
              </label>

              <label class="eg-setting-row" for="alt-navigation">
                <span>
                  <b data-lang-key="eg_alt_navigation">Alternative navigation</b>
                  <small data-lang-key="eg_alt_navigation_desc">Keep your main tabs close</small>
                </span>
                <md-switch id="alt-navigation" data-setting-switch="navigation" aria-label="Alternative navigation"></md-switch>
              </label>
            </div>
            <div class="eg-demo-caption"><span class="eg-caption-pulse"></span><span data-lang-key="eg_demo_caption">Live preview — try the controls</span></div>
          </div>
        </div>
      </section>

      <section class="eg-why" id="why" aria-labelledby="eg-why-title">
        <div class="eg-why-copy"><h2 id="eg-why-title" data-lang-key="eg_why_title">Why we made this fork.</h2><p data-lang-key="eg_why_copy">InuGram gives us a clean, patch-based foundation. entinyGram carries that work forward with its own privacy tools, interface controls, and experiments the upstream project chooses not to include.</p></div>
        <a class="eg-why-link" href="/features"><span data-lang-key="eg_why_link">See what belongs to each project</span><span class="eg-arrow" aria-hidden="true"></span></a>
      </section>

      <section class="eg-approach" id="approach" aria-labelledby="eg-approach-title">
        <div class="eg-approach-heading">
          <h2 id="eg-approach-title" data-lang-key="entinygram_arch_title">Patchset, not a heavy fork.</h2>
          <p data-lang-key="entinygram_arch_subtitle">Built as an atomic collection of patches applied over official Telegram Android.</p>
        </div>
        <div class="eg-approach-detail">
          <span class="eg-detail-mark" aria-hidden="true">e/</span>
          <div>
            <p data-lang-key="eg_approach_detail">entinyGram builds on the InuGram patchset and adds its own layer of customization, privacy controls, and experiments.</p>
            <a class="eg-inline-arrow" href="https://github.com/entaytion/entinyGram" target="_blank" rel="noopener noreferrer"><span data-lang-key="eg_read_repository">Read the repository</span><span class="eg-arrow" aria-hidden="true"></span></a>
          </div>
        </div>
      </section>

      <section class="eg-release-section" id="download" aria-labelledby="eg-release-title">
        <div class="eg-release-intro">
          <h2 id="eg-release-title" data-lang-key="eg_release_title">Ready when you are.</h2>
          <p data-lang-key="eg_release_copy">The latest stable build, straight from GitHub Releases.</p>
        </div>

        {latestRelease ? (
          <div class="eg-release-card">
            <div class="eg-release-mark" aria-hidden="true">e</div>
            <div class="eg-release-info">
              <span class="eg-release-label"><span class="eg-status-dot" aria-hidden="true"></span><span data-lang-key="eg_latest_stable">Latest stable release</span></span>
              <h3>{latestRelease.name || latestRelease.tag_name}</h3>
              <p>{latestRelease.tag_name} · {new Date(latestRelease.published_at).toLocaleDateString(pageLang === "uk" ? "uk-UA" : "en-US", { year: "numeric", month: "short", day: "numeric" })}</p>
            </div>
            <a class="eg-tech-btn eg-btn-primary" href={downloadUrl} target="_blank" rel="noopener noreferrer">
              <span class="eg-btn-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              </span>
              <span class="eg-btn-label">Download APK</span>
              <span class="eg-btn-meta">arm64-v8a ↗</span>
            </a>
          </div>
        ) : (
          <div class="eg-release-card eg-release-fallback">
            <div class="eg-release-mark" aria-hidden="true">e</div>
            <div class="eg-release-info">
              <span class="eg-release-label"><span class="eg-status-dot eg-dot-muted" aria-hidden="true"></span><span data-lang-key={releasesError ? "eg_releases_unavailable" : "eg_releases_none"}>{releasesError ? "Latest release is temporarily unavailable" : "No stable release is published yet"}</span></span>
              <h3 data-lang-key="eg_release_fallback_title">Find releases on GitHub</h3>
              <p data-lang-key="eg_release_fallback_copy">Browse available builds and release notes.</p>
            </div>
            <a class="eg-tech-btn" href="https://github.com/entaytion/entinyGram/releases" target="_blank" rel="noopener noreferrer">
              <span class="eg-btn-label">Open releases</span>
              <span class="eg-btn-meta">GitHub ↗</span>
            </a>
          </div>
        )}

        <div class="eg-release-links">
          <a href="/downloads" data-lang-key="eg_all_releases">All downloads <span class="eg-arrow" aria-hidden="true"></span></a>
          <a href="/faq" data-lang-key="entinygram_btn_faq">FAQ</a>
          <a href="/features" data-lang-key="entinygram_btn_features">All Features</a>
          <a href="/donate" class="eg-donate-pill" data-lang-key="eg_nav_donate">Support / Донат</a>
        </div>
      </section>


      <section class="eg-community" aria-label="entinyGram community links">
        <p data-lang-key="eg_community_title">Builds, updates, and community.</p>
        <div class="eg-community-links">
          <a href="https://t.me/entinyGram" target="_blank" rel="noopener noreferrer"><span data-lang-key="entinygram_tg_main_title">Main Channel</span><span>@entinyGram</span></a>
          <a href="https://t.me/entinyGramCI" target="_blank" rel="noopener noreferrer"><span data-lang-key="entinygram_tg_ci_title">CI Builds</span><span>@entinyGramCI</span></a>
          <a href="https://t.me/entinyGramChat" target="_blank" rel="noopener noreferrer"><span data-lang-key="entinygram_tg_chat_title">Community Chat</span><span>@entinyGramChat</span></a>
        </div>
      </section>
    </main>

    <EntinyGramFooter />
  </div>

  <script>
    import "@material/web/slider/slider.js";
    import "@material/web/switch/switch.js";

    const slider = document.querySelector("#avatar-radius");
    const radiusValue = document.querySelector("#avatar-radius-value");
    const preview = document.querySelector("#settings-preview");
    const updateRadius = () => {
      if (!slider || !radiusValue || !preview) return;
      const value = Number(slider.value);
      radiusValue.textContent = String(value);
      preview.style.setProperty("--avatar-radius", `${Math.round(2 + value * 1.25)}px`);
    };
    slider?.addEventListener("input", updateRadius);
    updateRadius();

    document.querySelectorAll("md-switch[data-setting-switch]").forEach((control) => {
      control.addEventListener("change", () => {
        if (!preview) return;
        const setting = control.getAttribute("data-setting-switch");
        if (setting === "font") preview.classList.toggle("use-system-font", control.selected);
        if (setting === "ghost") preview.classList.toggle("is-ghost-mode", control.selected);
        if (setting === "navigation") preview.classList.toggle("show-alt-navigation", control.selected);
      });
    });


  </script>

  <style>
    .eg-page {
      --eg-bg: #ffffff;
      --eg-surface: #f7f7f7;
      --eg-pink: rgba(242, 12, 60, 0.05);
      --eg-ink: #0a0a0a;
      --eg-muted: #666666;
      --eg-soft: #888888;
      --eg-red: #f20c3c;
      --eg-red-dark: #d10932;
      --eg-line: #ebebeb;
      --md-sys-color-primary: #f20c3c;
      --md-sys-color-on-primary: #ffffff;
      --md-sys-color-surface: #f7f7f7;
      --md-sys-color-on-surface: #0a0a0a;
      --md-sys-color-outline: #cccccc;
      --md-sys-color-secondary: #555555;
      --md-ref-typeface-plain: var(--font-main, "Overused Grotesk", sans-serif);
      --md-ref-typeface-brand: var(--font-main, "Overused Grotesk", sans-serif);
      --md-sys-typescale-label-large-font: var(--font-main, "Overused Grotesk", sans-serif);
      color: var(--eg-ink);
      background: var(--eg-bg);
      font-family: var(--font-main, "Overused Grotesk", sans-serif);
      overflow: clip;
    }

    .eg-page *, .eg-page *::before, .eg-page *::after { box-sizing: border-box; }
    .eg-page a { color: inherit; text-decoration: none; }
    .eg-page button { font: inherit; }


    /* Technical Segmented Key Buttons */
    .eg-hero-btns {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 28px;
    }
    .eg-tech-btn {
      display: inline-flex;
      align-items: stretch;
      height: 40px;
      border-radius: 4px;
      border: 1px solid var(--eg-line);
      background: var(--eg-surface);
      color: var(--eg-ink);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      overflow: hidden;
      cursor: pointer;
      box-sizing: border-box;
      transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    }
    .eg-btn-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      border-right: 1px solid var(--eg-line);
      background: rgba(0, 0, 0, 0.02);
      color: var(--eg-muted);
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .eg-btn-icon svg {
      display: block;
      color: inherit;
    }
    .eg-btn-label {
      display: inline-flex;
      align-items: center;
      padding: 0 14px;
      line-height: 1;
    }
    .eg-btn-meta {
      display: inline-flex;
      align-items: center;
      padding-right: 12px;
      font-size: 0.76rem;
      opacity: 0.65;
    }
    .eg-tech-btn:hover {
      border-color: var(--eg-red);
      color: var(--eg-red);
      background: #ffffff;
    }
    .eg-tech-btn:hover .eg-btn-icon {
      border-right-color: var(--eg-red);
      color: var(--eg-red);
    }
    
    /* Primary Accent Button - strictly white text & icon */
    .eg-btn-primary {
      background: var(--eg-red) !important;
      border-color: var(--eg-red) !important;
      color: #ffffff !important;
    }
    .eg-btn-primary .eg-btn-icon {
      background: rgba(0, 0, 0, 0.14) !important;
      border-right-color: rgba(255, 255, 255, 0.22) !important;
      color: #ffffff !important;
    }
    .eg-btn-primary *,
    .eg-btn-primary .eg-btn-label,
    .eg-btn-primary .eg-btn-meta,
    .eg-btn-primary svg {
      color: #ffffff !important;
      stroke: #ffffff !important;
    }
    .eg-btn-primary:hover {
      background: var(--eg-red-dark) !important;
      border-color: var(--eg-red-dark) !important;
      color: #ffffff !important;
    }

    .eg-hero { max-width: 1440px; min-height: 625px; margin: 0 auto; padding: 68px 5.2vw 100px; display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; gap: 4vw; }
    .eg-hero-copy { position: relative; z-index: 1; padding: 4px 0 0 2.2vw; }
    .eg-hero h1 { margin: 0; font-size: clamp(3.8rem, 7.7vw, 7.7rem); line-height: .93; letter-spacing: -.035em; font-weight: 500; }
    .eg-highlight { color: var(--eg-red); }
    .eg-hero-description { max-width: 480px; margin: 28px 0 0; color: var(--eg-muted); font-size: clamp(1rem, 1.35vw, 1.18rem); line-height: 1.65; }
    .eg-text-link, .eg-inline-arrow, .eg-inverse-link { display: inline-flex; align-items: center; gap: 10px; font-size: .91rem; font-weight: 500; }
    .eg-text-link:hover, .eg-inline-arrow:hover { color: var(--eg-red); }
    .eg-text-link span:last-child, .eg-inline-arrow span:last-child, .eg-inverse-link span:last-child { font-size: 1.16em; }
    .eg-arrow { position: relative; display: inline-block; width: 14px; height: 14px; flex: 0 0 auto; }
    .eg-arrow::before { content: ""; position: absolute; top: 2px; right: 2px; width: 7px; height: 7px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; }
    .eg-arrow::after { content: ""; position: absolute; left: 2px; bottom: 3px; width: 10px; height: 1.5px; background: currentColor; transform: rotate(-45deg); transform-origin: left center; }
    .eg-platform-note { display: flex; align-items: center; gap: 9px; margin-top: 42px; color: var(--eg-soft); font-size: .84rem; font-weight: 500; letter-spacing: .015em; }
    .eg-status-dot, .eg-caption-pulse, .eg-note-dot { width: 8px; height: 8px; flex: 0 0 auto; background: #3d9a67; border-radius: 50%; }

    .eg-hero-art { min-height: 435px; display: grid; place-items: center; position: relative; isolation: isolate; }
    .eg-hero-art::before { content: ""; position: absolute; z-index: -1; width: min(76%, 455px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(242, 12, 60, 0.08) 0%, transparent 70%); }
    .eg-app-window { width: min(76%, 420px); padding: 17px 18px 13px; border-radius: 12px; background: var(--eg-surface); border: 1px solid var(--eg-line); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.04); }
