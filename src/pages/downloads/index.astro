---
import Layout from "../../layouts/Layout.astro";
import EntinyGramHeader from "../../components/Header.astro";
import EntinyGramFooter from "../../components/Footer.astro";
import { getEntinyReleases } from "../../lib/entinygram";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=120, s-maxage=600, stale-while-revalidate=86400"
);

const releases = await getEntinyReleases();
const unavailable = releases.length === 0;

const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const uk = pageLang === "uk";
const dateOptions: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };

const parseArch = (filename: string) => {
  const lower = filename.toLowerCase();
  if (lower.includes("arm64-v8a") || lower.includes("arm64")) {
    return { tag: "ARM64", desc: uk ? "Сучасні 64-бітні пристрої (рекомендовано)" : "Modern 64-bit devices (recommended)", isRecommended: true };
  }
  if (lower.includes("armeabi-v7a") || lower.includes("armv7")) {
    return { tag: "ARMv7", desc: uk ? "Старі 32-бітні смартфони" : "Older 32-bit devices", isRecommended: false };
  }
  if (lower.includes("x86_64") || lower.includes("x86")) {
    return { tag: "x86_64", desc: uk ? "Емулятори та ПК" : "Emulators and x86 devices", isRecommended: false };
  }
  if (lower.includes("universal")) {
    return { tag: "Universal", desc: uk ? "Універсальна збірка (всі CPU)" : "Universal build (all CPUs)", isRecommended: false };
  }
  return { tag: "APK", desc: uk ? "Встановлювальний пакет" : "Installation package", isRecommended: false };
};
---

<Layout title={uk ? "Завантаження — entinyGram" : "Downloads — entinyGram"} description={uk ? "Офіційні збірки entinyGram для Android прямо з GitHub Releases." : "Official entinyGram Android APK builds straight from GitHub Releases."} favicon="/favicon.svg" image="/og/entinygram-banner.png" lang={pageLang}>
  <EntinyGramHeader active="downloads" />
  <main class="downloads-page">
    <section class="download-hero">
      <h1 data-lang-key="eg_downloads_title">{uk ? "Оберіть свою збірку." : "Choose your build."}</h1>
      <p data-lang-key="eg_downloads_intro">{uk ? "Версії публікуються напряму з GitHub Releases. Оберіть архітектуру вашого пристрою або перегляньте історію релізів." : "Versions are pulled directly from GitHub Releases. Select the build for your device architecture or browse notes."}</p>
      <div class="hero-actions">
        <a class="eg-tech-btn" href="https://github.com/entaytion/entinyGram/releases" target="_blank" rel="noopener noreferrer">
          <span class="eg-btn-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </span>
          <span class="eg-btn-label">GitHub Releases</span>
          <span class="eg-btn-meta">↗</span>
        </a>
      </div>
    </section>

    {unavailable ? (
      <section class="release-empty">
        <h2 data-lang-key="eg_downloads_unavailable_title">GitHub is temporarily unavailable</h2>
        <p data-lang-key="eg_downloads_unavailable_copy">The release list could not load. Open the releases page directly.</p>
        <a class="eg-tech-btn eg-btn-primary" href="https://github.com/entaytion/entinyGram/releases" target="_blank" rel="noopener noreferrer">
          <span class="eg-btn-label">Open GitHub Releases ↗</span>
        </a>
      </section>
    ) : releases.length === 0 ? (
      <section class="release-empty">
        <h2 data-lang-key="eg_downloads_empty_title">No published builds yet</h2>
        <p data-lang-key="eg_downloads_empty_copy">Check the releases page again later.</p>
      </section>
    ) : (
      <section class="release-list" aria-label={uk ? "Опубліковані релізи" : "Published releases"}>
        {releases.map((release, index) => {
          const apkAssets = release.assets.filter((asset) => asset.name.toLowerCase().endsWith(".apk"));
          return (
            <article class:list={["release-card", index === 0 && !release.prerelease && "is-latest"]}>
              <div class="release-header">
                <div class="release-title-block">
                  <div class="release-meta">
                    <span class="release-state">
                      <span class:list={["status-dot", release.prerelease ? "is-preview" : ""]} aria-hidden="true"></span>
                      <span>{release.prerelease ? (uk ? "Пре-реліз" : "Pre-release") : index === 0 ? (uk ? "Останній стабільний реліз" : "Latest stable release") : (uk ? "Стабільний реліз" : "Stable release")}</span>
                    </span>
                    <time datetime={release.published_at}>{new Date(release.published_at).toLocaleDateString(uk ? "uk-UA" : "en-US", dateOptions)}</time>
                  </div>
                  <h2>{release.name || release.tag_name}</h2>
                  <span class="release-tag">{release.tag_name}</span>
                </div>
                <a class="release-gh-link" href={release.html_url} target="_blank" rel="noopener noreferrer">
                  <span>GitHub</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>

              {apkAssets.length > 0 ? (
                <div class="asset-grid">
                  {apkAssets.map((asset) => {
                    const meta = parseArch(asset.name);
                    return (
                      <div class:list={["asset-item", { "is-rec": meta.isRecommended }]}>
                        <div class="asset-icon" aria-hidden="true">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                          </svg>
                        </div>
                        <div class="asset-info">
                          <div class="asset-headline">
                            <span class="asset-arch">{meta.tag}</span>
                            {meta.isRecommended && <span class="asset-badge">{uk ? "Рекомендовано" : "Recommended"}</span>}
                            <span class="asset-size">{asset.size ? `${(asset.size / 1024 / 1024).toFixed(1)} MB` : "APK"}</span>
                          </div>
                          <span class="asset-desc">{meta.desc}</span>
                          <span class="asset-filename">{asset.name}</span>
                        </div>
                        <a class:list={["asset-btn", { "is-primary": meta.isRecommended }]} href={asset.browser_download_url} download>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                          <span>{uk ? "Завантажити" : "Download"}</span>
                        </a>
                      </div>
                    );
                  })}
                </div>
              ) : (
                <p class="no-apk" data-lang-key="eg_downloads_no_apk">No APK files are attached to this release.</p>
              )}

              <details class="release-notes" open={index === 0}>
                <summary>
                  <span data-lang-key="eg_downloads_changed">{uk ? "Примітки до релізу" : "Release notes"}</span>
                  <span class="notes-chevron" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </span>
                </summary>
                {release.body ? (
                  <div class="changelog-body" set:html={release.body} />
                ) : (
                  <p class="notes-empty" data-lang-key="eg_downloads_notes_empty">Full release notes are available on GitHub.</p>
                )}
              </details>
            </article>
          );
        })}
      </section>
    )}

    <p class="download-footnote" data-lang-key="eg_downloads_footnote">
      {uk ? "Встановлення сторонніх APK та використання модифікованого клієнта — це ваш вибір. Завжди перевіряйте джерело файлу." : "Installing a third-party APK and using a modified client is your choice. Always verify the file source."}
    </p>
  </main>
  <EntinyGramFooter />
</Layout>

<style>
  .downloads-page {
    --d-bg: #ffffff;
    --d-card: #f7f7f7;
    --d-ink: #0a0a0a;
    --d-muted: #666666;
    --d-soft: #888888;
    --d-line: #ebebeb;
    --d-accent: #f20c3c;
    --d-accent-dark: #d10932;
    min-height: 75vh;
    padding-bottom: 6rem;
    background: var(--d-bg);
    color: var(--d-ink);
    font-family: var(--font-main, "Overused Grotesk", sans-serif);
  }
  .downloads-page *, .downloads-page *::before, .downloads-page *::after {
    box-sizing: border-box;
  }
  :global([data-theme="dark"]) .downloads-page {
    --d-bg: #030502;
    --d-card: #080b07;
    --d-ink: #f0f2f0;
    --d-muted: #88908a;
    --d-soft: #5e6460;
    --d-line: #141813;
    --d-accent: #f20c3c;
    --d-accent-dark: #d10932;
  }

  .download-hero {
    max-width: 1200px;
    margin: auto;
    padding: 72px 28px 40px;
  }
  .download-hero h1 {
    max-width: 900px;
    margin: 0 0 14px;
    font-size: clamp(3rem, 6.5vw, 6rem);
    line-height: .98;
    letter-spacing: -.035em;
    font-weight: 500;
  }
  .download-hero p {
    max-width: 680px;
    margin: 0;
    color: var(--d-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .hero-actions {
    margin-top: 24px;
    display: flex;
    gap: 12px;
  }

  /* Technical Segmented Key Button */
  .eg-tech-btn {
    display: inline-flex;
    align-items: stretch;
    height: 38px;
    border-radius: 4px;
    border: 1px solid var(--d-line);
    background: var(--d-card);
    color: var(--d-ink);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .eg-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    border-right: 1px solid var(--d-line);
    background: rgba(0, 0, 0, 0.02);
    color: var(--d-muted);
  }
  .eg-btn-label {
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
  }
  .eg-btn-meta {
    display: inline-flex;
    align-items: center;
    padding-right: 10px;
    font-size: 0.76rem;
    opacity: 0.65;
  }
  .eg-tech-btn:hover {
    border-color: var(--d-accent);
    color: var(--d-accent);
  }

  .release-list {
    max-width: 1200px;
    margin: auto;
    padding: 12px 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .release-card {
    padding: 28px 32px;
    border: 1px solid var(--d-line);
    border-radius: 8px;
    background: var(--d-card);
    transition: border-color 0.15s ease;
  }
  .release-card:hover {
    border-color: color-mix(in srgb, var(--d-accent) 30%, var(--d-line));
  }
  .release-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--d-line);
  }
  .release-title-block h2 {
    margin: 6px 0 4px;
    font-size: 1.55rem;
    letter-spacing: -.025em;
    font-weight: 500;
    color: var(--d-ink);
  }
  .release-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--d-muted);
    font-size: 0.8rem;
  }
  .release-state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #3d9a67;
    font-weight: 500;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3d9a67;
  }
  .status-dot.is-preview {
    background: #f0b44c;
  }
  .release-tag {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 3px;
    background: var(--d-bg);
    border: 1px solid var(--d-line);
    color: var(--d-muted);
    font-size: 0.76rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .release-gh-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid var(--d-line);
    background: var(--d-bg);
    color: var(--d-muted);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .release-gh-link:hover {
    color: var(--d-accent);
    border-color: var(--d-accent);
  }

  /* Asset Grid */
  .asset-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 20px 0;
  }
  .asset-item {
    display: grid;
    grid-template-columns: 42px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border: 1px solid var(--d-line);
    border-radius: 6px;
    background: var(--d-bg);
    transition: border-color 0.15s ease;
  }
  .asset-item.is-rec {
    border-color: color-mix(in srgb, var(--d-accent) 45%, var(--d-line));
  }
  .asset-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: rgba(242, 12, 60, 0.08);
    color: var(--d-accent);
  }
  .asset-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .asset-headline {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .asset-arch {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--d-ink);
  }
  .asset-badge {
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(61, 154, 103, 0.12);
    color: #3d9a67;
    font-size: 0.72rem;
    font-weight: 500;
  }
  .asset-size {
    color: var(--d-muted);
    font-size: 0.78rem;
    margin-left: auto;
  }
  .asset-desc {
    color: var(--d-muted);
    font-size: 0.8rem;
  }
  .asset-filename {
    color: var(--d-soft);
    font-size: 0.74rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .asset-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 4px;
    border: 1px solid var(--d-line);
    background: var(--d-card);
    color: var(--d-ink);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .asset-btn:hover {
    border-color: var(--d-accent);
    color: var(--d-accent);
  }
  .asset-btn.is-primary {
    background: var(--d-accent);
    border-color: var(--d-accent);
    color: #ffffff !important;
  }
  .asset-btn.is-primary:hover {
    background: var(--d-accent-dark);
    border-color: var(--d-accent-dark);
  }
  .asset-btn.is-primary svg {
    stroke: #ffffff;
  }

  .release-notes {
    margin-top: 14px;
    border-top: 1px solid var(--d-line);
    padding-top: 14px;
  }
  .release-notes > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    list-style: none;
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--d-ink);
    user-select: none;
  }
  .release-notes > summary::-webkit-details-marker {
    display: none;
  }
  .notes-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--d-accent);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .notes-chevron svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .release-notes[open] .notes-chevron {
    transform: rotate(180deg);
  }

  .changelog-body {
    max-width: 100%;
    max-height: 360px;
    overflow: auto;
    padding: 12px 0 4px;
    color: var(--d-muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }
  .changelog-body :global(h1), .changelog-body :global(h2), .changelog-body :global(h3), .changelog-body :global(h4) {
    margin: 16px 0 6px;
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--d-ink);
  }
  .changelog-body :global(p) {
    margin: 6px 0;
  }
  .changelog-body :global(ul), .changelog-body :global(ol) {
    padding-left: 20px;
    margin: 6px 0 12px;
  }
  .changelog-body :global(li) {
    padding: 2px 0;
  }
  .changelog-body :global(a) {
    color: var(--d-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .changelog-body :global(code) {
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--d-card);
    border: 1px solid var(--d-line);
    font-size: 0.88em;
  }

  .download-footnote {
    max-width: 1200px;
    margin: 28px auto 0;
    padding: 0 28px;
    color: var(--d-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .release-empty {
    max-width: 1200px;
    margin: 24px auto;
    padding: 32px 28px;
    border: 1px solid var(--d-line);
    border-radius: 8px;
    background: var(--d-card);
    text-align: center;
  }
  .release-empty h2 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 1.3rem;
  }
  .release-empty p {
    color: var(--d-muted);
    margin: 0 0 16px;
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .download-hero { padding-top: 50px; }
    .release-card { padding: 20px; }
    .asset-item { grid-template-columns: 1fr; gap: 12px; }
    .asset-icon { display: none; }
    .asset-size { margin-left: 0; }
    .asset-btn { justify-content: center; width: 100%; }
  }
</style>