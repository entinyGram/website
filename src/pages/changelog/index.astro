---
import Layout from "../../layouts/Layout.astro";
import EntinyGramHeader from "../../components/Header.astro";
import EntinyGramFooter from "../../components/Footer.astro";
import { listChangelog, parseNotes, sectionsFromCard, type ChangelogEntry } from "../../lib/changelog";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
);

let entries: ChangelogEntry[] = [];
let failed = false;
try {
  entries = await listChangelog();
} catch (err) {
  console.error("[changelog] page failed", err);
  failed = true;
}

const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const uk = pageLang === "uk";
const dateOptions: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
const t = uk
  ? { title: "Що нового.", intro: "Усі зміни в кожному релізі: нові можливості, покращення та виправлення.", latest: "Останній", pre: "Пре-реліз", empty: "Записів поки немає.", failed: "Не вдалося завантажити список. Спробуйте пізніше.", github: "Реліз на GitHub", all: "Усі релізи на GitHub ↗", more: (n: number) => `Ще ${n}`, news: "Нові можливості", fixes: "Виправлення", build: "збірка" }
  : { title: "What's new.", intro: "Every change in every release: new features, improvements and fixes.", latest: "Latest", pre: "Pre-release", empty: "No entries yet.", failed: "The list could not load. Please try again later.", github: "Release on GitHub", all: "All releases on GitHub ↗", more: (n: number) => `Show ${n} more`, news: "New features", fixes: "Bug fixes", build: "build" };

const SHOWN = 7;

const releases = entries.map((entry, index) => {
  const md = (uk ? entry.md.uk || entry.md.en : entry.md.en || entry.md.uk).trim();
  const card = uk ? (entry.uk.highlights.length || entry.uk.fixes.length ? entry.uk : entry.en) : (entry.en.highlights.length || entry.en.fixes.length ? entry.en : entry.uk);
  const sections = md ? parseNotes(md, pageLang as "en" | "uk") : sectionsFromCard(card, t);
  const m = entry.version.match(/(?:entinyGram\s+)?(\d+(?:\.\d+)+)(?:-([a-f0-9]+|\w+))?(?:\s*\((\d+)\))?/i);
  const ver = m ? m[1] : entry.version;
  const build = entry.build || (m?.[2] && !/^\d+$/.test(m[2]) ? m[2] : "");
  return {
    entry,
    sections,
    ver,
    build,
    latest: index === 0 && !entry.prerelease,
  };
});
---

<Layout title={`${uk ? "Що нового" : "Changelog"} — entinyGram`} description={uk ? "Нові можливості та виправлення кожного релізу entinyGram." : "New features and fixes in every entinyGram release."} favicon="/favicon.svg" image="/og/entinygram-banner.png" lang={pageLang}>
  <EntinyGramHeader active="changelog" />
  <main class="cl-page">
    <section class="cl-hero">
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
      <div class="cl-hero-actions">
        <a class="eg-tech-btn" href="https://github.com/entaytion/entinyGram/releases" target="_blank" rel="noopener noreferrer">
          <span class="eg-btn-icon" aria-hidden="true">
            <span class="iconify" data-icon="tabler:brand-github"></span>
          </span>
          <span class="eg-btn-label">GitHub Releases</span>
          <span class="eg-btn-meta">↗</span>
        </a>
      </div>
    </section>

    {failed || releases.length === 0 ? (
      <section class="cl-empty"><p>{failed ? t.failed : t.empty}</p></section>
    ) : (
      <section class="cl-feed">
        {releases.map((r) => (
          <article class="cl-release" id={`v${r.entry.version}`}>
            <aside class="cl-aside">
              <h2 class="cl-ver">{r.ver}</h2>
              <time class="cl-date" datetime={r.entry.published_at}>{new Date(r.entry.published_at).toLocaleDateString(uk ? "uk-UA" : "en-US", dateOptions)}</time>
              <div class="cl-tags">
                {r.latest && <span class="cl-tag-latest">{t.latest}</span>}
                {r.entry.prerelease && <span class="cl-tag-pre">{t.pre}</span>}
                {r.build && <span class="cl-tag-build">{r.build}</span>}
              </div>
              {r.entry.url && (
                <a class="cl-link-gh" href={r.entry.url} target="_blank" rel="noopener noreferrer">
                  <span>{t.github}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </aside>

            <div class="cl-body">
              {r.sections.map((section) => {
                const count = section.items.length;
                const head = section.items.slice(0, SHOWN);
                const rest = section.items.slice(SHOWN);
                const row = (item: { name: string; text: string; html?: string }) => (
                  <li class="cl-item">
                    {item.name ? (
                      <>
                        <span class="cl-item-name">{item.name}</span>
                        <span class="cl-item-desc">{item.html ? <span set:html={item.html} /> : item.text}</span>
                      </>
                    ) : (
                      <span class="cl-item-full">{item.html ? <span set:html={item.html} /> : item.text}</span>
                    )}
                  </li>
                );
                return (
                  <section class={`cl-sec is-${section.kind}`}>
                    <header class="cl-sec-header">
                      <span class="cl-sec-dot" aria-hidden="true">●</span>
                      <h3 class="cl-sec-title">{section.title}</h3>
                      <span class="cl-sec-count">{count}</span>
                    </header>
                    <ul class="cl-items">{head.map(row)}</ul>
                    {rest.length > 0 && (
                      <details class="cl-more">
                        <summary class="cl-more-trigger">
                          <span>{t.more(rest.length)}</span>
                        </summary>
                        <ul class="cl-items">{rest.map(row)}</ul>
                      </details>
                    )}
                  </section>
                );
              })}
            </div>
          </article>
        ))}
      </section>
    )}
  </main>
  <EntinyGramFooter />
</Layout>

<script is:inline>
  const renderedLanguage = ["uk", "ua"].includes(document.documentElement.lang) ? "ua" : "en";
  window.addEventListener("site-language-change", (event) => {
    if (event.detail?.lang === renderedLanguage) return;
    const url = new URL(location.href);
    url.searchParams.set("lang", event.detail.lang);
    location.assign(url);
  });
</script>

<style>
  .cl-page {
    --c-bg: #ffffff;
    --c-ink: #0a0a0a;
    --c-muted: #666666;
    --c-line: #ebebeb;
    --c-accent: #f20c3c;
    min-height: 75vh;
    padding-bottom: 6rem;
    background: var(--c-bg);
    color: var(--c-ink);
    font-family: var(--font-main, "Overused Grotesk", sans-serif);
  }
  .cl-page *, .cl-page *::before, .cl-page *::after {
    box-sizing: border-box;
  }
  :global([data-theme="dark"]) .cl-page {
    --c-bg: #030502;
    --c-ink: #f0f2f0;
    --c-muted: #88908a;
    --c-line: #141813;
    --c-accent: #f20c3c;
  }

  .cl-hero {
    max-width: 1200px;
    margin: auto;
    padding: 72px 28px 40px;
  }
  .cl-hero h1 {
    max-width: 900px;
    margin: 0 0 14px;
    font-size: clamp(3rem, 6.5vw, 6rem);
    line-height: .98;
    letter-spacing: -.035em;
    font-weight: 500;
  }
  .cl-hero p {
    max-width: 680px;
    margin: 0;
    color: var(--c-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .cl-hero-actions {
    margin-top: 24px;
  }

  /* Technical Segmented Key Button */
  .eg-tech-btn {
    display: inline-flex;
    align-items: stretch;
    height: 38px;
    border-radius: 4px;
    border: 1px solid var(--c-line);
    background: transparent;
    color: var(--c-ink);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .eg-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    border-right: 1px solid var(--c-line);
    color: var(--c-muted);
  }
  .eg-btn-icon .iconify {
    width: 16px;
    height: 16px;
  }
  .eg-btn-label {
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
  }
  .eg-btn-meta {
    display: inline-flex;
    align-items: center;
    padding-right: 10px;
    font-size: 0.76rem;
    opacity: 0.65;
  }
  .eg-tech-btn:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .cl-empty {
    max-width: 1200px;
    margin: 20px auto;
    padding: 32px 28px;
    border: 1px solid var(--c-line);
    border-radius: 4px;
    color: var(--c-muted);
  }

  .cl-feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 28px;
    display: flex;
    flex-direction: column;
  }

  /* Release Article: Open Two-Column Technical Layout */
  .cl-release {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 48px;
    padding-bottom: 64px;
    margin-bottom: 64px;
    border-bottom: 1px solid var(--c-line);
  }
  .cl-release:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Left Aside Column (Version, Date, Tag, GitHub Link) */
  .cl-aside {
    position: sticky;
    top: 32px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cl-ver {
    margin: 0;
    font-size: 2.2rem;
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--c-ink);
  }
  .cl-date {
    font-size: 0.85rem;
    color: var(--c-muted);
    margin-bottom: 8px;
  }
  .cl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }
  .cl-tag-latest {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--c-accent);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .cl-tag-pre {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(240, 180, 76, 0.12);
    border: 1px solid rgba(240, 180, 76, 0.3);
    color: #f0b44c;
    font-size: 0.72rem;
    font-weight: 500;
  }
  .cl-tag-build {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    font-size: 0.72rem;
    font-weight: 500;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .cl-link-gh {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--c-accent);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .cl-link-gh:hover {
    text-decoration: underline;
  }

  /* Right Body Column */
  .cl-body {
    display: flex;
    flex-direction: column;
    gap: 36px;
    min-width: 0;
  }

  .cl-sec {
    display: flex;
    flex-direction: column;
  }

  /* Section Header (● CATEGORY  COUNT) */
  .cl-sec-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--c-line);
    margin: 0;
  }
  .cl-sec-dot {
    font-size: 0.65rem;
    line-height: 1;
  }
  .cl-sec-title {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cl-sec-count {
    font-size: 0.74rem;
    color: var(--c-muted);
    font-weight: 400;
  }

  /* Category Accents */
  .cl-sec.is-new .cl-sec-dot,
  .cl-sec.is-new .cl-sec-title {
    color: #f20c3c;
  }
  .cl-sec.is-improve .cl-sec-dot,
  .cl-sec.is-improve .cl-sec-title {
    color: #e88d2a;
  }
  .cl-sec.is-fix .cl-sec-dot,
  .cl-sec.is-fix .cl-sec-title {
    color: #3d9a67;
  }
  .cl-sec.is-other .cl-sec-dot,
  .cl-sec.is-other .cl-sec-title {
    color: var(--c-muted);
  }

  /* List Items */
  .cl-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cl-item {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--c-line);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .cl-item-name {
    min-width: 170px;
    max-width: 220px;
    flex-shrink: 0;
    font-weight: 500;
    color: var(--c-ink);
  }
  .cl-item-desc {
    flex: 1;
    color: var(--c-muted);
  }
  .cl-item-desc a {
    color: var(--c-accent);
    text-decoration: none;
  }
  .cl-item-desc a:hover {
    text-decoration: underline;
  }
  .cl-item-full {
    flex: 1;
    color: var(--c-ink);
  }
  .cl-item-full a {
    color: var(--c-accent);
    text-decoration: none;
  }
  .cl-item-full a:hover {
    text-decoration: underline;
  }

  /* "Ще N" / Expand */
  .cl-more {
    margin-top: 2px;
  }
  .cl-more-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 13px 0;
    color: var(--c-accent);
    font-size: 0.84rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .cl-more-trigger::-webkit-details-marker {
    display: none;
  }
  .cl-more-trigger:hover {
    text-decoration: underline;
  }
  .cl-more[open] > .cl-more-trigger {
    display: none;
  }

  @media (max-width: 780px) {
    .cl-release {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-bottom: 48px;
      margin-bottom: 48px;
    }
    .cl-aside {
      position: static;
    }
    .cl-item {
      flex-direction: column;
      gap: 4px;
    }
    .cl-item-name {
      min-width: 0;
      max-width: 100%;
    }
  }
</style>
