---
import Layout from "../../layouts/Layout.astro";
import EntinyGramHeader from "../../components/Header.astro";
import EntinyGramFooter from "../../components/Footer.astro";
import { listChangelog, parseNotes, sectionsFromCard, type ChangelogEntry } from "../../lib/changelog";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
);

let entries: ChangelogEntry[] = [];
let failed = false;
try {
  entries = await listChangelog();
} catch (err) {
  console.error("[changelog] page failed", err);
  failed = true;
}

const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const uk = pageLang === "uk";
const dateOptions: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
const t = uk
  ? { title: "Що нового.", intro: "Усі зміни в кожному релізі: нові можливості, покращення та виправлення.", latest: "Останній", pre: "Пре-реліз", empty: "Записів поки немає.", failed: "Не вдалося завантажити список. Спробуйте пізніше.", github: "Реліз на GitHub", all: "Усі релізи на GitHub ↗", more: (n: number) => `Ще ${n}`, news: "Нові можливості", fixes: "Виправлення", build: "збірка" }
  : { title: "What's new.", intro: "Every change in every release: new features, improvements and fixes.", latest: "Latest", pre: "Pre-release", empty: "No entries yet.", failed: "The list could not load. Please try again later.", github: "Release on GitHub", all: "All releases on GitHub ↗", more: (n: number) => `Show ${n} more`, news: "New features", fixes: "Bug fixes", build: "build" };

const SHOWN = 7;

const releases = entries.map((entry, index) => {
  const md = (uk ? entry.md.uk || entry.md.en : entry.md.en || entry.md.uk).trim();
  const card = uk ? (entry.uk.highlights.length || entry.uk.fixes.length ? entry.uk : entry.en) : (entry.en.highlights.length || entry.en.fixes.length ? entry.en : entry.uk);
  const sections = md ? parseNotes(md, pageLang as "en" | "uk") : sectionsFromCard(card, t);
  const m = entry.version.match(/(?:entinyGram\s+)?(\d+(?:\.\d+)+)(?:-([a-f0-9]+|\w+))?(?:\s*\((\d+)\))?/i);
  const ver = m ? m[1] : entry.version;
  const build = entry.build || (m?.[2] && !/^\d+$/.test(m[2]) ? m[2] : "");
  return {
    entry,
    sections,
    ver,
    build,
    latest: index === 0 && !entry.prerelease,
  };
});
---

<Layout title={`${uk ? "Що нового" : "Changelog"} — entinyGram`} description={uk ? "Нові можливості та виправлення кожного релізу entinyGram." : "New features and fixes in every entinyGram release."} favicon="/favicon.svg" image="/og/entinygram-banner.png" lang={pageLang}>
  <EntinyGramHeader active="changelog" />
  <main class="cl-page">
    <section class="cl-hero">
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
      <a class="cl-link" href="https://github.com/entaytion/entinyGram/releases" target="_blank" rel="noopener noreferrer">{t.all}</a>
    </section>

    {failed || releases.length === 0 ? (
      <section class="cl-empty"><p>{failed ? t.failed : t.empty}</p></section>
    ) : (
      <section class="cl-feed">
        {releases.map((r) => (
          <article class="cl-release" id={`v${r.entry.version}`}>
            <aside class="cl-aside">
              <div class="cl-ver">{r.ver}</div>
              <time class="cl-date" datetime={r.entry.published_at}>{new Date(r.entry.published_at).toLocaleDateString(uk ? "uk-UA" : "en-US", dateOptions)}</time>
              <div class="cl-tags">
                {r.latest && <span class="cl-tag is-latest">{t.latest}</span>}
                {r.entry.prerelease && <span class="cl-tag is-pre">{t.pre}</span>}
                {r.build && <span class="cl-tag is-build">{r.build}</span>}
              </div>
              {r.entry.url && <a class="cl-link" href={r.entry.url} target="_blank" rel="noopener noreferrer">{t.github} ↗</a>}
            </aside>
            <div class="cl-body">
              {r.sections.map((section) => {
                const head = section.items.slice(0, SHOWN);
                const rest = section.items.slice(SHOWN);
                const row = (item: { name: string; text: string; html?: string }) => (
                  <li class:list={[item.name ? "has-name" : ""]}>
                    {item.name && <strong>{item.name}</strong>}
                    {item.html ? <span set:html={item.html} /> : <span>{item.text}</span>}
                  </li>
                );
                return (
                  <section class={`cl-section is-${section.kind}`}>
                    <h3><i aria-hidden="true"></i>{section.title}<span class="cl-count">{section.items.length}</span></h3>
                    <ul class="cl-items">{head.map(row)}</ul>
                    {rest.length > 0 && (
                      <details class="cl-more">
                        <summary>{t.more(rest.length)}</summary>
                        <ul class="cl-items">{rest.map(row)}</ul>
                      </details>
                    )}
                  </section>
                );
              })}
            </div>
          </article>
        ))}
      </section>
    )}
  </main>
  <EntinyGramFooter />
</Layout>

<script is:inline>
  const renderedLanguage = ["uk", "ua"].includes(document.documentElement.lang) ? "ua" : "en";
  window.addEventListener("site-language-change", (event) => {
    if (event.detail?.lang === renderedLanguage) return;
    const url = new URL(location.href);
    url.searchParams.set("lang", event.detail.lang);
    location.assign(url);
  });
</script>

<style>
  .cl-page{--c-bg:#fff;--c-ink:#201a19;--c-muted:#6c6260;--c-line:#e9ddda;--c-accent:#b3261e;--c-soft:#fff0ee;--k-new:#b3261e;--k-improve:#a86a00;--k-fix:#1f7a4d;--k-other:#6c6260;min-height:75vh;padding-bottom:6rem;background:var(--c-bg);color:var(--c-ink)}
  .cl-page *,.cl-page *::before,.cl-page *::after{box-sizing:border-box}
  :global([data-theme="dark"]) .cl-page{--c-bg:#151312;--c-ink:#f5eeec;--c-muted:#bcb0ad;--c-line:#403634;--c-accent:#ff8a80;--c-soft:#382321;--k-new:#ff8a80;--k-improve:#f0b44c;--k-fix:#6fd09b;--k-other:#bcb0ad}
  .cl-hero{max-width:1200px;margin:auto;padding:82px 28px 40px}
  h1{max-width:900px;margin:0 0 14px;font-size:clamp(3.2rem,7vw,6.8rem);line-height:.96;letter-spacing:-.035em}
  .cl-hero>p{max-width:690px;color:var(--c-muted);font-size:1.08rem;line-height:1.7}
  .cl-link{display:inline-block;margin-top:13px;color:var(--c-accent);font-size:.85rem;font-weight:750}
  .cl-empty{max-width:1144px;margin:12px auto 0;padding:25px 28px;color:var(--c-muted)}

  .cl-feed{max-width:1200px;margin:0 auto;padding:0 28px}
  .cl-release{display:grid;grid-template-columns:230px minmax(0,1fr);gap:48px;padding:48px 0;border-top:1px solid var(--c-line)}
  .cl-aside{position:sticky;top:24px;align-self:start}
  .cl-ver{font-size:clamp(2.1rem,3.6vw,3rem);font-weight:800;line-height:1;letter-spacing:-.04em}
  .cl-date{display:block;margin-top:10px;color:var(--c-muted);font-size:.88rem}
  .cl-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
  .cl-tag{padding:4px 10px;border-radius:999px;font-size:.72rem;font-weight:800;letter-spacing:.02em}
  .cl-tag.is-latest{background:var(--c-accent);color:var(--c-bg)}
  .cl-tag.is-pre{background:#f6e7b8;color:#6f5300}
  .cl-tag.is-build{border:1px solid var(--c-line);color:var(--c-muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600}
  .cl-aside .cl-link{margin-top:18px}

  .cl-section{margin:0 0 34px}
  .cl-section:last-child{margin-bottom:0}
  .cl-section h3{display:flex;align-items:center;gap:10px;margin:0;font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--kind)}
  .cl-section.is-new{--kind:var(--k-new)}.cl-section.is-improve{--kind:var(--k-improve)}.cl-section.is-fix{--kind:var(--k-fix)}.cl-section.is-other{--kind:var(--k-other)}
  .cl-section h3 i{width:8px;height:8px;border-radius:50%;background:var(--kind)}
  .cl-count{margin-left:2px;color:var(--c-muted);font-weight:600;letter-spacing:0}
  .cl-items{list-style:none;margin:10px 0 0;padding:0}
  .cl-items li{padding:13px 0;border-bottom:1px solid var(--c-line);font-size:.95rem;line-height:1.6;color:var(--c-muted)}
  .cl-items li.has-name{display:grid;grid-template-columns:minmax(150px,210px) minmax(0,1fr);gap:22px}
  .cl-items li strong{color:var(--c-ink);font-weight:750;letter-spacing:-.01em}
  .cl-items li:not(.has-name){color:var(--c-ink)}
  .cl-items a{color:var(--c-accent);text-decoration:underline;text-underline-offset:2px}
  .cl-items a:hover{opacity:.8}
  .cl-more{margin-top:2px}
  .cl-more>summary{display:inline-block;margin-top:12px;list-style:none;cursor:pointer;color:var(--c-accent);font-size:.84rem;font-weight:750}
  .cl-more>summary::-webkit-details-marker{display:none}
  .cl-more[open]>summary{display:none}

  @media(max-width:860px){.cl-release{grid-template-columns:1fr;gap:22px;padding:36px 0}.cl-aside{position:static;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 16px}.cl-date,.cl-tags,.cl-aside .cl-link{margin-top:0}}
  @media(max-width:560px){.cl-hero{padding-top:60px}.cl-feed{padding:0 20px}.cl-items li.has-name{grid-template-columns:1fr;gap:3px}}
</style>
