---
import Layout from "../../layouts/Layout.astro";
import EntinyGramHeader from "../../components/Header.astro";
import EntinyGramFooter from "../../components/Footer.astro";
import featureMarkdown from "../../content/entinygram-features.md?raw";
import { renderSafeMarkdown } from "../../lib/safe-markdown";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=120, s-maxage=600, stale-while-revalidate=86400"
);

const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const uk = pageLang === "uk";

const highlights = uk ? [
  ["Ghost Mode", "Приховуй прочитання, перегляди історій і статус набору. Налаштуй винятки для окремих чатів."],
  ["Архів повідомлень", "Переглядай видалені повідомлення й медіа та порівнюй версії відредагованого тексту."],
  ["Захищений контент", "Копіюй текст із захищених чатів, зберігай історії й медіа для одноразового перегляду."],
  ["Переклад і голосові", "Перекладай цілі чати й транскрибуй голосові через обраного провайдера."],
] : [
  ["Ghost Mode", "Hide read receipts, story views and typing status. Set exceptions for individual chats."],
  ["Message archive", "Find deleted messages and media, and compare versions of edited text."],
  ["Protected content", "Copy text from protected chats and save stories and view-once media."],
  ["Translation and voice", "Translate entire chats and transcribe voice messages with your chosen provider."],
];

const ukrainianTopics: Record<string, string> = {
  "privacy & protection": "Приватність і захист",
  "unlocks & restrictions": "Захищений контент і локальні можливості",
  "translation & ai": "Переклад і ШІ",
  "appearance & customization": "Вигляд і налаштування",
  "profile & identity": "Профіль і обліковий запис",
  "messages & sending": "Повідомлення й надсилання",
  "media, camera & player": "Медіа, камера й плеєр",
  "chat list & folders": "Список чатів і папки",
  "notifications & calls": "Сповіщення й дзвінки",
  "proxy, plugins & performance": "Плагіни й продуктивність",
  "debloat & premium noise": "Приховування зайвих елементів",
};

const additions = featureMarkdown.split(/^## entinygram additions\s*$/im)[1]?.split(/^## /m)[0] ?? "";
const topics = await Promise.all(additions.split(/^### /m).slice(1).map(async (section) => {
  const [title, ...lines] = section.trim().split(/\r?\n/);
  const body = lines.join("\n").replaceAll("🗑️", "&#x1F5D1;&#xFE0F;");
  return {
    title: uk ? ukrainianTopics[title] ?? title : title.replace("proxy, ", "").replace(" & ai", " & AI"),
    body: await renderSafeMarkdown(body),
  };
}));

const description = uk
  ? "Ghost Mode, архів видалених повідомлень, переклад чатів та інші можливості entinyGram для Telegram на Android."
  : "Ghost Mode, a deleted message archive, chat translation and more from entinyGram for Telegram on Android.";
---

<Layout title={`${uk ? "Можливості" : "Features"} — entinyGram`} description={description} image="/og/entinygram-banner.png" lang={pageLang}>
  <EntinyGramHeader active="features" />
  <main id="main-content" class="feature-page">
    <div class="feature-wrap">
      <section class="feature-hero" aria-labelledby="feature-title">
        <div class="hero-copy">
          <h1 id="feature-title">{uk ? "Можливості entinyGram" : "entinyGram features"}</h1>
          <p>{uk ? "Приватність, робота з повідомленнями й налаштування інтерфейсу в Telegram для Android." : "Privacy controls, message tools and interface settings for Telegram on Android."}</p>
          <a class="catalog-link" href="#full-list">
            {uk ? "Переглянути весь список" : "Browse all features"}
            <span class="down-arrow" aria-hidden="true"></span>
          </a>
        </div>
      </section>

      <section class="highlights" aria-labelledby="highlights-title">
        <h2 id="highlights-title">{uk ? "Чати й повідомлення" : "Chats and messages"}</h2>
        <div class="highlight-list">
          {highlights.map(([title, copy]) => (
            <article>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="catalog" id="full-list" aria-labelledby="catalog-title">
        <div class="catalog-intro">
          <h2 id="catalog-title">{uk ? "Усі можливості" : "All features"}</h2>
          <p>{uk ? "Більшість перемикачів знайдеш у Налаштування → entinyGram. Базові можливості описані в" : "Find most toggles under Settings → entinyGram. For the features shared with InuGram, see"} <a href="https://github.com/teidesu/inugram/blob/main/FEATURES.md">{uk ? "переліку InuGram" : "the InuGram list"}</a>.</p>
          {uk && <p class="catalog-language">Докладний перелік нижче англійською.</p>}
        </div>
        <div class="topics">
          {topics.map(({ title, body }) => (
            <details>
              <summary>
                <h3>{title}</h3>
                <span class="topic-icon" aria-hidden="true"></span>
              </summary>
              <div class="topic-body" lang="en" set:html={body} />
            </details>
          ))}
          <a class="catalog-source" href="https://github.com/entaytion/entinyGram/blob/main/FEATURES.md">FEATURES.md · GitHub</a>
        </div>
      </section>
    </div>
  </main>
  <EntinyGramFooter />
</Layout>

<script is:inline>
  const renderedLanguage = ["uk", "ua"].includes(document.documentElement.lang) ? "ua" : "en";
  window.addEventListener("site-language-change", (event) => {
    if (event.detail?.lang === renderedLanguage) return;
    const url = new URL(location.href);
    url.searchParams.set("lang", event.detail.lang);
    location.assign(url);
  });
</script>

<style>
  .feature-page {
    background: var(--clr-bg);
    color: var(--clr-text);
  }

  .feature-wrap {
    width: min(86%, 1200px);
    margin-inline: auto;
    padding-block: clamp(42px, 7vw, 96px) clamp(70px, 10vw, 144px);
  }

  .highlights,
  .catalog {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 7vw, 112px);
  }

  .feature-hero {
    padding-bottom: clamp(36px, 5vw, 70px);
  }

  .feature-hero h1,
  .feature-page h2,
  .feature-page h3,
  .feature-page p {
    margin: 0;
  }

  .feature-hero h1 {
    font-size: clamp(2.75rem, 5.9vw, 5.9rem);
    line-height: .99;
    letter-spacing: -.04em;
    font-weight: 560;
  }

  .hero-copy > p {
    max-width: 54ch;
    margin-top: 22px;
    font-size: clamp(1rem, 1.45vw, 1.2rem);
  }

  .feature-page p {
    color: var(--clr-text-muted);
    line-height: 1.65;
  }

  .catalog-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 14px;
    margin-top: 22px;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    background: var(--clr-active-bg);
    color: var(--clr-active-text);
    font-weight: 550;
    text-decoration: none;
    transition: transform var(--trans-fast);
  }

  .catalog-link:hover { transform: translateY(-2px); }
  .catalog-link:active { transform: translateY(1px); }

  .down-arrow {
    width: 8px;
    height: 8px;
    margin-bottom: 4px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .highlights,
  .catalog {
    padding-block: clamp(32px, 6vw, 74px);
    border-top: 1px solid var(--clr-border);
  }

  .feature-page h2 {
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 550;
    text-wrap: balance;
  }

  .highlight-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 24px;
  }

  .highlight-list h3 {
    margin-bottom: 6px;
    font-size: 1.18rem;
    font-weight: 650;
  }

  .catalog {
    scroll-margin-top: calc(var(--header-height) + 3rem);
    padding-bottom: 0;
  }

  .catalog-intro p {
    max-width: 38ch;
    margin-top: 16px;
  }

  .catalog-intro .catalog-language { font-size: .95rem; }

  .catalog-intro a,
  .catalog-source,
  .topic-body :global(a) {
    color: var(--clr-link);
    text-underline-offset: .2em;
  }

  .topics { min-width: 0; }
  .topics details { border-bottom: 1px solid var(--clr-border); }
  .topics details:first-child { border-top: 1px solid var(--clr-border); }

  .topics summary {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 4px;
    cursor: pointer;
    list-style: none;
  }

  .topics summary::-webkit-details-marker { display: none; }
  .topics summary:hover,
  .topics details[open] summary { color: var(--clr-link); }

  .topics h3 {
    font-size: 1.12rem;
    font-weight: 600;
  }

  .topics h3::first-letter { text-transform: uppercase; }

  .topic-icon {
    display: grid;
    flex: 0 0 22px;
    height: 22px;
    place-items: center;
    color: var(--clr-link);
  }

  .topic-icon::before,
  .topic-icon::after {
    grid-area: 1 / 1;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    content: "";
  }

  .topic-icon::after { transform: rotate(90deg); }
  details[open] .topic-icon::after { transform: none; }

  .topic-body {
    padding: 0 4px 22px;
    color: var(--clr-text-muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .topic-body :global(ul) {
    margin: 0;
    padding-left: 19px;
  }

  .topic-body :global(li + li) { margin-top: 9px; }
  .topic-body :global(strong) { color: var(--clr-text); }

  .catalog-source {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 10px;
    font-size: .95rem;
  }

  @media (max-width: 760px) {
    .highlights,
    .catalog { grid-template-columns: 1fr; }

    .feature-wrap { width: calc(100% - 40px); }
    .feature-hero h1 { font-size: clamp(2.6rem, 9vw, 4rem); }
  }

  @media (max-width: 390px) {
    .highlight-list { grid-template-columns: 1fr; gap: 20px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: hero-in .45s cubic-bezier(.16, 1, .3, 1) both; }
    @keyframes hero-in {
      from { opacity: .82; transform: translateY(7px); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-link { transition: none; }
    :global(html:has(.feature-page)) { scroll-behavior: auto; }
  }
</style>
