---
import Layout from "../../layouts/Layout.astro";
import EntinyGramHeader from "../../components/Header.astro";
import EntinyGramFooter from "../../components/Footer.astro";
import { getRecentDonations, getLatestBalance } from "../../lib/donations";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=86400"
);

const [recentDonations, latestBalanceKopecks] = await Promise.all([
  getRecentDonations(8).catch(() => []),
  getLatestBalance().catch(() => null),
]);

const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const uk = pageLang === "uk";

const TARGET_UAH = 18549;
const currentUah = latestBalanceKopecks !== null ? Math.round(latestBalanceKopecks / 100) : 0;
const progressPercent = Math.min(100, Math.max(0, Math.round((currentUah / TARGET_UAH) * 100)));

const formatUah = (kopecks: number) =>
  `${Math.round(kopecks / 100).toLocaleString("uk-UA")} ₴`;

const formatRelativeTime = (iso: string) => {
  const diffMs = Date.now() - new Date(iso).getTime();
  const minutes = Math.round(diffMs / 60000);
  if (minutes < 1) return uk ? "щойно" : "just now";
  if (minutes < 60) return uk ? `${minutes} хв тому` : `${minutes}m ago`;
  const hours = Math.round(minutes / 60);
  if (hours < 24) return uk ? `${hours} год тому` : `${hours}h ago`;
  const days = Math.round(hours / 24);
  return uk ? `${days} дн тому` : `${days}d ago`;
};

const cryptoWallets = [
  {
    coin: "ETH",
    icon: "tabler:brand-ethereum",
    network: "Ethereum Mainnet",
    address: "0x1D8cf5A876188256931a6D2FB1F4FAFCB5C03a99",
    desc: uk ? "Нативний ETH у мережі Ethereum Mainnet." : "Native ETH on Ethereum Mainnet.",
  },
  {
    coin: "USDC",
    icon: "tabler:coin",
    network: "Base",
    address: "0x1D8cf5A876188256931a6D2FB1F4FAFCB5C03a99",
    desc: uk ? "Офіційний стейблкоїн USDC у мережі Base." : "Official USDC on Base network.",
  },
  {
    coin: "GRAM / TON",
    icon: "tabler:diamond",
    network: "TON network",
    address: "UQBgCQmC-kT8W2AQfEUavuIszQEN-iuR8LUUNJkHeIN2oW5m",
    desc: uk ? "Токени мережі The Open Network." : "Tokens on The Open Network (TON).",
  },
  {
    coin: "SOL",
    icon: "tabler:currency-solana",
    network: "Solana Mainnet",
    address: "BWKK9NwmMFMa4N4MbRYg8yNH2A3zNJxNYNxTBSNZAzXr",
    desc: uk ? "Швидкі перекази у мережі Solana." : "Fast transfers via Solana Mainnet.",
  },
  {
    coin: "BTC",
    icon: "tabler:currency-bitcoin",
    network: "Bitcoin Native SegWit",
    address: "bc1qk9n4mru8skrdw94k6g5s5wcm0ucwlrwqlgxjq7",
    desc: uk ? "Біткоїн Bech32 Native SegWit." : "Native SegWit (Bech32) Bitcoin.",
  },
];
---

<Layout
  title={uk ? "Підтримати розробку — entinyGram" : "Support entinyGram Development"}
  description={uk ? "Донат на підтримку та розвиток клієнта entinyGram: Monobank Банка, крипта, SWIFT/IBAN." : "Support entinyGram open-source development: Monobank Jar, crypto, and wire transfer."}
  favicon="/favicon.svg"
  image="/og/entinygram-banner.png"
  lang={pageLang}
>
  <EntinyGramHeader active="donate" />

  <main class="donate-page">
    <section class="donate-hero">
      <h1>{uk ? "Підтримай проєкт." : "Keep entinyGram Alive."}</h1>
      <p class="donate-hero-lead">
        {uk
          ? "entinyGram — повністю безкоштовний патчсет із відкритим кодом. Жодної реклами, трекерів, аналітики чи платних підписок. Усі внески йдуть на оплату серверів, автоматичних CI/CD збірок та підтримку нових функцій."
          : "entinyGram is an open-source patchset built for freedom: zero ads, zero tracking, zero paywalls. Every contribution directly funds build servers, CI pipelines, and active development."}
      </p>

      <div class="donate-origin-note">
        <span class="note-icon" aria-hidden="true">
          <span class="iconify" data-icon="tabler:map-pin"></span>
        </span>
        <span>
          {uk
            ? "Розробка з мікрорайону Лезневе, Хмельницький. Сам з Луганщини — додому хочеться, та їхати вже нема куди."
            : "Developed in Lezneve, Khmelnytskyi. Originally from Luhansk region — longing to return home, but there's nowhere left to go."}
        </span>
      </div>
    </section>

    <div class="donate-container">
      <!-- MONOBANK CARD -->
      <section class="monobank-card" aria-label={uk ? "Банка Monobank" : "Monobank Jar"}>
        <div class="card-top-row">
          <div class="card-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            <span class="iconify badge-icon" data-icon="tabler:heart-handshake" aria-hidden="true"></span>
            <span>{uk ? "Основний збір" : "Primary Fund"}</span>
          </div>
          <span class="jar-status-label">
            <span class="live-dot" aria-hidden="true"></span>
            <span>{uk ? "Наживо через Monobank" : "Live via Monobank"}</span>
          </span>
        </div>

        <div class="target-row">
          <div class="target-info">
            <span class="target-title">{uk ? "Ціль збору на сервери" : "Server & Build Target"}</span>
            <div class="target-nums">
              <strong class="target-amount">{TARGET_UAH.toLocaleString("uk-UA")} ₴</strong>
              {latestBalanceKopecks !== null && (
                <span class="balance-tag">
                  {uk ? "у банці:" : "in jar:"} <b>{formatUah(latestBalanceKopecks)}</b>
                </span>
              )}
            </div>
          </div>
          <div class="progress-percent-badge" aria-label={`Progress: ${progressPercent}%`}>
            <span>{progressPercent}%</span>
          </div>
        </div>

        <!-- Progress track -->
        <div class="progress-track" role="progressbar" aria-valuenow={progressPercent} aria-valuemin="0" aria-valuemax="100">
          <div class="progress-fill" style={`--progress: ${progressPercent / 100};`}></div>
        </div>

        <!-- Action row -->
        <div class="jar-actions">
          <a
            href="https://send.monobank.ua/jar/RGYa8zo8y"
            target="_blank"
            rel="noopener noreferrer"
            class="eg-tech-btn is-primary"
          >
            <span class="eg-btn-icon" aria-hidden="true">
              <span class="iconify" data-icon="tabler:building-bank"></span>
            </span>
            <span class="eg-btn-label">{uk ? "Закинути в банку Monobank" : "Contribute to Monobank Jar"}</span>
            <span class="eg-btn-meta">↗</span>
          </a>

          <a
            href="https://t.me/send?start=IVncNnKfmByl"
            target="_blank"
            rel="noopener noreferrer"
            class="eg-tech-btn"
          >
            <span class="eg-btn-icon" aria-hidden="true">
              <span class="iconify" data-icon="tabler:brand-telegram"></span>
            </span>
            <span class="eg-btn-label">Crypto Bot</span>
            <span class="eg-btn-meta">↗</span>
          </a>
        </div>

        <!-- Card Number Quick Copy -->
        <div class="card-copy-box">
          <div class="card-copy-content">
            <span class="card-label">{uk ? "Прямий переказ на картку Monobank" : "Direct Monobank Card"}</span>
            <span class="card-number font-mono" id="mono-card-number">4874 1000 3949 4128</span>
          </div>
          <button
            type="button"
            class="copy-btn copy-card-action"
            data-copy="4874100039494128"
            aria-label={uk ? "Скопіювати номер картки" : "Copy card number"}
          >
            <span class="iconify" data-icon="tabler:copy" aria-hidden="true"></span>
            <span class="btn-text">{uk ? "Копіювати" : "Copy"}</span>
          </button>
        </div>

        <!-- Recent Donations Feed -->
        {recentDonations && recentDonations.length > 0 && (
          <div class="recent-feed-block">
            <div class="recent-feed-header">
              <span class="recent-feed-title">
                <span class="iconify" data-icon="tabler:heart" aria-hidden="true"></span>
                <span>{uk ? "Останні внески в банку" : "Recent Supporters"}</span>
              </span>
              <span class="recent-feed-count">{recentDonations.length}</span>
            </div>
            <div class="recent-feed-list">
              {recentDonations.map((tx) => (
                <div class="feed-item">
                  <div class="feed-avatar" aria-hidden="true">
                    <span class="iconify" data-icon="tabler:arrow-down-left"></span>
                  </div>
                  <div class="feed-details">
                    <span class="feed-name">{tx.sender || tx.comment || (uk ? "Анонімний добродій" : "Anonymous")}</span>
                    {tx.comment && tx.comment !== tx.sender && (
                      <span class="feed-comment">«{tx.comment}»</span>
                    )}
                  </div>
                  <div class="feed-meta">
                    <strong class="feed-amount">{formatUah(tx.amount)}</strong>
                    <time class="feed-time">{formatRelativeTime(tx.created_at)}</time>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>

      <!-- TWO-COLUMN GRID: INTERNATIONAL WIRE & CRYPTO -->
      <div class="sub-grid">
        <!-- INTERNATIONAL WIRE (SWIFT / IBAN) -->
        <section class="bento-card wire-card" aria-label={uk ? "Міжнародний переказ SWIFT/IBAN" : "International Wire"}>
          <div class="card-head">
            <div class="card-head-title">
              <span class="iconify" data-icon="tabler:world" aria-hidden="true"></span>
              <h2>SWIFT / IBAN</h2>
            </div>
            <span class="head-note">Revolut, Wise, etc.</span>
          </div>

          <p class="wire-intro">
            {uk
              ? "Немає української картки? Будь-який міжнародний банк чи платіжний сервіс підтримує перекази за реквізитами IBAN/SWIFT:"
              : "No Ukrainian bank account? Any international bank or fintech service supports direct wire transfers with these details:"}
          </p>

          <div class="wire-details">
            <div class="wire-row">
              <span class="wire-label">{uk ? "Одержувач" : "Beneficiary"}</span>
              <strong class="wire-val">Kulinich Oleksii Serhiiovych</strong>
            </div>

            <div class="wire-row">
              <span class="wire-label">{uk ? "Адреса одержувача" : "Beneficiary address"}</span>
              <div class="wire-copyable">
                <span class="wire-val">69 Soborna St, Khmelnytskyy, Khmelnytskyy Oblast, 29000, Ukraine</span>
                <button type="button" class="copy-pill copy-card-action" data-copy="69 Soborna St, Khmelnytskyy, Khmelnytskyy Oblast, 29000, Ukraine" aria-label="Copy Address">
                  <span class="iconify" data-icon="tabler:copy" aria-hidden="true"></span>
                  <span>{uk ? "Копія" : "Copy"}</span>
                </button>
              </div>
            </div>

            <div class="wire-row">
              <span class="wire-label">IBAN</span>
              <div class="wire-copyable">
                <strong class="wire-val font-mono">UA613220010000026204380821818</strong>
                <button type="button" class="copy-pill copy-card-action" data-copy="UA613220010000026204380821818" aria-label="Copy IBAN">
                  <span class="iconify" data-icon="tabler:copy" aria-hidden="true"></span>
                  <span>{uk ? "Копія" : "Copy"}</span>
                </button>
              </div>
            </div>

            <div class="wire-row">
              <span class="wire-label">SWIFT / BIC</span>
              <div class="wire-copyable">
                <strong class="wire-val font-mono">UNJSUAUKXXX</strong>
                <button type="button" class="copy-pill copy-card-action" data-copy="UNJSUAUKXXX" aria-label="Copy SWIFT">
                  <span class="iconify" data-icon="tabler:copy" aria-hidden="true"></span>
                  <span>{uk ? "Копія" : "Copy"}</span>
                </button>
              </div>
            </div>

            <div class="wire-row">
              <span class="wire-label">{uk ? "Банк" : "Bank"}</span>
              <span class="wire-val">Universal Bank, Kyiv, Ukraine</span>
            </div>

            <div class="wire-row">
              <span class="wire-label">{uk ? "ІПН (Tax ID)" : "Tax ID"}</span>
              <div class="wire-copyable">
                <strong class="wire-val font-mono">3825206378</strong>
                <button type="button" class="copy-pill copy-card-action" data-copy="3825206378" aria-label="Copy Tax ID">
                  <span class="iconify" data-icon="tabler:copy" aria-hidden="true"></span>
                  <span>{uk ? "Копія" : "Copy"}</span>
                </button>
              </div>
            </div>

            <div class="wire-row">
              <span class="wire-label">{uk ? "Призначення" : "Purpose"}</span>
              <span class="wire-val">{uk ? "Поповнення власного рахунку" : "Account top-up"}</span>
            </div>
          </div>
        </section>

        <!-- CRYPTO ASSETS -->
        <section class="bento-card crypto-card" aria-label={uk ? "Криптовалютні донати" : "Crypto Donations"}>
          <div class="card-head">
            <div class="card-head-title">
              <span class="iconify" data-icon="tabler:coins" aria-hidden="true"></span>
              <h2>{uk ? "Криптогаманці" : "Direct Crypto"}</h2>
            </div>
            <span class="head-note">{uk ? "Перевіряйте мережу" : "Check network"}</span>
          </div>

          <div class="crypto-list">
            {cryptoWallets.map((w) => (
              <div class="crypto-item">
                <div class="crypto-top">
                  <div class="crypto-title-row">
                    <span class="coin-badge">
                      <span class="iconify" data-icon={w.icon} aria-hidden="true"></span>
                      <span>{w.coin}</span>
                    </span>
                    <span class="network-badge">{w.network}</span>
                  </div>
                  <button
                    type="button"
                    class="copy-icon-btn copy-card-action"
                    data-copy={w.address}
                    title={uk ? `Скопіювати ${w.coin} адресу` : `Copy ${w.coin} address`}
                    aria-label={`Copy ${w.coin} address`}
                  >
                    <span class="iconify" data-icon="tabler:copy" aria-hidden="true"></span>
                    <span>{uk ? "Копіювати" : "Copy"}</span>
                  </button>
                </div>
                <div class="crypto-address-row">
                  <code class="crypto-code font-mono">{w.address}</code>
                </div>
                <p class="crypto-desc">{w.desc}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="copy-toast" class="copy-toast" role="status" aria-live="polite">
      <span class="toast-icon">
        <span class="iconify" data-icon="tabler:check"></span>
      </span>
      <span class="toast-msg">{uk ? "Скопійовано в буфер!" : "Copied to clipboard!"}</span>
    </div>
  </main>

  <EntinyGramFooter />
</Layout>

<script is:inline>
  const toast = document.getElementById("copy-toast");
  let toastTimer;

  const showToast = (message) => {
    if (!toast) return;
    if (message) toast.querySelector(".toast-msg").textContent = message;
    toast.classList.add("is-visible");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove("is-visible");
    }, 2200);
  };

  document.querySelectorAll(".copy-card-action").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const originalText = btn.innerHTML;
        btn.classList.add("is-copied");
        showToast("Скопійовано: " + text.slice(0, 16) + (text.length > 16 ? "…" : ""));
        setTimeout(() => {
          btn.classList.remove("is-copied");
        }, 1800);
      } catch (err) {
        showToast("Помилка копіювання");
      }
    });
  });

  const renderedLanguage = ["uk", "ua"].includes(document.documentElement.lang) ? "ua" : "en";
  window.addEventListener("site-language-change", (event) => {
    if (event.detail?.lang === renderedLanguage) return;
    const url = new URL(location.href);
    url.searchParams.set("lang", event.detail.lang);
    location.assign(url);
  });
</script>

<style>
  .donate-page {
    --dp-bg: #ffffff;
    --dp-card: #f7f7f7;
    --dp-card-elevated: #ffffff;
    --dp-ink: #0a0a0a;
    --dp-muted: #666666;
    --dp-line: #ebebeb;
    --dp-accent: #f20c3c;
    --dp-accent-hover: #d10932;
    min-height: 80vh;
    padding-bottom: 7rem;
    background: var(--dp-bg);
    color: var(--dp-ink);
    font-family: var(--font-main, "Overused Grotesk", sans-serif);
  }
  .donate-page *, .donate-page *::before, .donate-page *::after {
    box-sizing: border-box;
  }

  :global([data-theme="dark"]) .donate-page {
    --dp-bg: #030502;
    --dp-card: #080b07;
    --dp-card-elevated: #0e120d;
    --dp-ink: #f0f2f0;
    --dp-muted: #88908a;
    --dp-line: #141813;
    --dp-accent: #f20c3c;
    --dp-accent-hover: #d10932;
  }

  .donate-hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 28px 36px;
  }
  .donate-hero h1 {
    margin: 0 0 16px;
    font-size: clamp(3rem, 6.5vw, 5.8rem);
    line-height: .98;
    letter-spacing: -.035em;
    font-weight: 500;
  }
  .donate-hero-lead {
    max-width: 720px;
    margin: 0 0 24px;
    color: var(--dp-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .donate-origin-note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 4px;
    border: 1px solid var(--dp-line);
    background: var(--dp-card);
    color: var(--dp-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .note-icon {
    display: inline-flex;
    align-items: center;
    color: var(--dp-accent);
  }
  .note-icon .iconify {
    width: 16px;
    height: 16px;
  }

  .donate-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Monobank Card */
  .monobank-card {
    padding: 32px 36px;
    border: 1px solid var(--dp-line);
    border-radius: 8px;
    background: var(--dp-card);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid var(--dp-line);
    background: var(--dp-bg);
    color: var(--dp-ink);
    font-size: 0.76rem;
    font-weight: 500;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dp-accent);
  }
  .badge-icon {
    width: 14px;
    height: 14px;
    color: var(--dp-accent);
  }
  .jar-status-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--dp-muted);
    font-size: 0.78rem;
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3d9a67;
  }

  .target-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }
  .target-title {
    display: block;
    font-size: 0.8rem;
    color: var(--dp-muted);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .target-nums {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .target-amount {
    font-size: 2.2rem;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--dp-ink);
  }
  .balance-tag {
    font-size: 0.85rem;
    color: var(--dp-muted);
  }
  .balance-tag b {
    color: #3d9a67;
    font-weight: 500;
  }

  .progress-percent-badge {
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid var(--dp-line);
    background: var(--dp-bg);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--dp-ink);
  }

  /* Progress Track */
  .progress-track {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--dp-line);
    overflow: hidden;
    margin-bottom: 24px;
  }
  .progress-fill {
    width: 100%;
    height: 100%;
    background: var(--dp-accent);
    transform-origin: left center;
    transform: scaleX(var(--progress, 0));
    transition: transform 0.4s ease;
  }

  /* Actions */
  .jar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  /* Segmented Technical Buttons */
  .eg-tech-btn {
    display: inline-flex;
    align-items: stretch;
    height: 40px;
    border-radius: 4px;
    border: 1px solid var(--dp-line);
    background: var(--dp-bg);
    color: var(--dp-ink);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .eg-tech-btn .eg-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    border-right: 1px solid var(--dp-line);
    color: var(--dp-muted);
