---
import "../styles/main.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  favicon?: string;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, favicon = "/favicon.svg", lang = "en", jsonLd } = Astro.props;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "https://entiny.tech").replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ? new URL(image, siteUrl).href : undefined;
const initialTheme = Astro.cookies.get("theme")?.value === "dark" ? "dark" : "light";
---

<!doctype html>
<html lang={lang} data-theme={initialTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={initialTheme === "dark" ? "#100d0e" : "#ffffff"} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "uk" ? "uk_UA" : "en_US"} />
    <meta property="og:site_name" content="entinyGram" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preload" href="https://raw.githubusercontent.com/RandomMaerks/Overused-Grotesk/master/fonts/variable/OverusedGrotesk-VF.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline src="/js/theme.js"></script>
    <script src="https://code.iconify.design/3/3.1.1/iconify.min.js" defer></script>
  </head>
  <body class="eg-body">
    <a class="skip-link" href="#main-content">{lang === "uk" ? "До основного вмісту" : "Skip to content"}</a>
    <slot />
    <script is:inline src="/js/entinygram.js"></script>
    <Analytics />
  </body>
</html>

<style is:global>
  html { font-size: 106.25%; }
  body.eg-body { min-height:100vh; margin:0; background:var(--clr-bg); color:var(--clr-text); font-family:var(--font-main,"Overused Grotesk",sans-serif); line-height:1.5; transition:background-color .2s ease,color .2s ease; }
  body.eg-body *, body.eg-body *::before, body.eg-body *::after { box-sizing:border-box; }
  body.eg-body :focus-visible { outline:2px solid #f20c3c; outline-offset:2px; }
  [data-theme="dark"] body.eg-body :focus-visible { outline-color:#f20c3c; }
  body.eg-body ::selection { color:#fff; background:#f20c3c; }
  [data-theme="dark"] body.eg-body ::selection { background:#f20c3c; }
  .skip-link { position:absolute; z-index:100; top:8px; left:8px; padding:10px 14px; background:var(--clr-active-bg); color:var(--clr-active-text); transform:translateY(-150%); }
  .skip-link:focus { transform:none; }
  @media (prefers-reduced-motion: reduce) { html, html:has(main) { scroll-behavior:auto; } }
</style>
