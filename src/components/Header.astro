---
interface Props { active?: "home" | "branding" | "features" | "changelog" | "faq" | "docs" | "downloads" | "donate" }
const { active = "home" } = Astro.props;
const langCookie = Astro.cookies.get("lang")?.value;
const requestedLang = Astro.url.searchParams.get("lang");
const pageLang = requestedLang === "ua" ? "uk" : requestedLang === "en" ? "en" : langCookie === "ua" ? "uk" : "en";
const uk = pageLang === "uk";
---

<div class="eg-top-banner" id="egTopBanner" role="region" aria-label="Support announcement">
  <div class="eg-top-banner-inner">
    <span class="eg-banner-badge" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </span>
    <span class="eg-banner-text" data-lang-key="eg_banner_text">{uk ? "Підтримай розвиток entinyGram та оплату збірок" : "Support entinyGram development & CI build servers"}</span>
    <a class="eg-banner-link" href="/donate">
      <span data-lang-key="eg_banner_cta">{uk ? "Донат" : "Donate"}</span>
      <span aria-hidden="true">↗</span>
    </a>
    <button class="eg-banner-close" id="egBannerClose" type="button" aria-label="Dismiss announcement">×</button>
  </div>
</div>

<header class="eg-shell-header" id="egHeader">
  <a class="eg-shell-brand" href="/" aria-label="entinyGram home">
    <svg class="eg-brand-glyph" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
      <path d="M4 10a7.31 7.31 0 0 0 10 10Z" />
      <path d="m9 15 3-3" />
      <path d="M17 13a6 6 0 0 0-6-6" />
      <path d="M21 13A10 10 0 0 0 11 3" />
    </svg>
  </a>

  <nav class="eg-shell-nav" id="egNav" aria-label="entinyGram navigation">
    <a class:list={{ "is-active": active === "features" }} href="/features" data-lang-key="eg_nav_features">Features</a>
    <a class:list={{ "is-active": active === "changelog" }} href="/changelog" data-lang-key="eg_nav_changelog">Changelog</a>
    <a class:list={{ "is-active": active === "docs" }} href="/docs" data-lang-key="eg_nav_docs">Docs</a>
    <a class:list={{ "is-active": active === "faq" }} href="/faq" data-lang-key="eg_nav_faq">FAQ</a>
    <a class:list={{ "is-active": active === "donate" }} href="/donate" data-lang-key="eg_nav_support">{uk ? "Підтримка" : "Support"}</a>
  </nav>

  <div class="eg-shell-actions">
    <a class:list={["eg-shell-dl-btn", { "is-active": active === "downloads" }]} href="/downloads">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span data-lang-key="eg_nav_download">Downloads</span>
    </a>
    <button class="eg-shell-theme" id="themeToggle" type="button" aria-label="Toggle theme"><span class="iconify" data-icon="solar:moon-bold"></span></button>
    <div class="eg-shell-language" aria-label="Choose language">
      <button class="lang-btn" type="button" data-lang="en" aria-label="English">EN</button>
      <span aria-hidden="true"></span>
      <button class="lang-btn" type="button" data-lang="ua" aria-label="Українська">UA</button>
    </div>
    <button class="eg-shell-burger" id="egBurger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="egNav"><span></span><span></span><span></span></button>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("egHeader");
    const burger = document.getElementById("egBurger");
    if (!header || !burger) return;
    const set = (open) => {
      header.classList.toggle("is-open", open);
      burger.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("eg-menu-open", open);
    };
    burger.addEventListener("click", () => set(!header.classList.contains("is-open")));
    header.querySelectorAll(".eg-shell-nav a").forEach((link) => link.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") set(false); });
    document.addEventListener("click", (event) => { if (!header.contains(event.target)) set(false); });
    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => { if (event.matches) set(false); });

    const banner = document.getElementById("egTopBanner");
    const bannerClose = document.getElementById("egBannerClose");
    if (banner && sessionStorage.getItem("eg_banner_closed")) {
      banner.style.display = "none";
    }
    bannerClose?.addEventListener("click", () => {
      if (banner) banner.style.display = "none";
      sessionStorage.setItem("eg_banner_closed", "1");
    });
  })();
</script>

<style is:global>
  /* Top Announcement Bar ("плашка") */
  .eg-top-banner {
    width: 100%;
    border-bottom: 1px solid var(--shell-line, #ebebeb);
    background: var(--shell-bg, #ffffff);
    color: var(--shell-ink, #0a0a0a);
    font-size: 0.82rem;
    font-weight: 500;
    position: relative;
    z-index: 30;
    font-family: var(--font-main, "Overused Grotesk", sans-serif);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  [data-theme="dark"] .eg-top-banner {
    border-color: #141813;
    background: #030502;
    color: #f0f2f0;
  }
  .eg-top-banner-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 7px 4vw;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .eg-banner-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: rgba(242, 12, 60, 0.12);
    color: var(--shell-accent, #f20c3c);
    flex-shrink: 0;
  }
  .eg-banner-badge svg {
    display: block;
  }
  .eg-banner-text {
    flex: 1;
    color: var(--shell-muted, #666666);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-theme="dark"] .eg-banner-text {
    color: #88908a;
  }
  .eg-banner-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 9px;
    border-radius: 4px;
    background: var(--shell-accent, #f20c3c);
    color: #ffffff !important;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
    flex-shrink: 0;
  }
  .eg-banner-link:hover {
    background: #d10932;
  }
  .eg-banner-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: none;
    background: transparent;
    color: var(--shell-muted, #666666);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.15s ease, background 0.15s ease;
    flex-shrink: 0;
    padding: 0;
  }
  .eg-banner-close:hover {
    color: var(--shell-ink, #0a0a0a);
    background: rgba(0, 0, 0, 0.05);
  }
  [data-theme="dark"] .eg-banner-close {
    color: #88908a;
  }
  [data-theme="dark"] .eg-banner-close:hover {
    color: #f0f2f0;
    background: rgba(255, 255, 255, 0.08);
  }

  .eg-shell-header {
    --shell-bg: #ffffff;
    --shell-ink: #0a0a0a;
    --shell-muted: #666666;
    --shell-accent: #f20c3c;
    --shell-line: #ebebeb;
    --shell-hover: #f5f5f5;
    position: relative;
    z-index: 20;
    max-width: 1320px;
    height: 68px;
    margin: 0 auto;
    padding: 0 4vw;
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--shell-ink);
    background: var(--shell-bg);
    font-family: var(--font-main, "Overused Grotesk", sans-serif);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  [data-theme="dark"] .eg-shell-header {
    --shell-bg: #030502;
    --shell-ink: #f0f2f0;
    --shell-muted: #88908a;
    --shell-accent: #f20c3c;
    --shell-line: #141813;
    --shell-hover: #0c100d;
  }
  .eg-shell-header *, .eg-shell-header *::before, .eg-shell-header *::after { box-sizing: border-box; }
  
  .eg-shell-brand {
    display: inline-flex;
    align-items: center;
    color: var(--shell-ink);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .eg-shell-brand:hover {
    color: var(--shell-accent);
  }
  .eg-brand-glyph {
    display: block;
  }

  .eg-shell-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: 12px;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .eg-shell-nav a {
    color: var(--shell-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .eg-shell-nav a:hover, .eg-shell-nav a.is-active {
    color: var(--shell-ink);
  }
  .eg-shell-ext {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .eg-shell-ext .eg-arrow {
    font-size: 0.78rem;
    opacity: 0.6;
  }

  .eg-shell-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .eg-shell-dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    font-size: 0.84rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid var(--shell-line);
    color: var(--shell-ink);
    background: transparent;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .eg-shell-dl-btn:hover, .eg-shell-dl-btn.is-active {
    border-color: var(--shell-accent);
    color: var(--shell-accent);
    background: rgba(242, 12, 60, 0.04);
  }

  .eg-shell-theme {
    width: 36px;
    height: 36px;
    border: 1px solid var(--shell-line);
    border-radius: 6px;
    background: transparent;
    color: var(--shell-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.1rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .eg-shell-theme:hover {
    border-color: var(--shell-accent);
    color: var(--shell-accent);
  }

  .eg-shell-language {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0 4px;
  }
  .eg-shell-language button {
    background: none;
    border: none;
    color: var(--shell-muted);
    cursor: pointer;
    font-weight: inherit;
    font-size: inherit;
    padding: 2px 4px;
    transition: color 0.15s ease;
  }
  .eg-shell-language button:hover, .eg-shell-language button.active {
    color: var(--shell-accent);
  }
  .eg-shell-language span {
    width: 1px;
    height: 12px;
    background: var(--shell-line);
  }

  .eg-shell-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--shell-line);
    border-radius: 6px;
    background: none;
    cursor: pointer;
    padding: 8px;
  }
  .eg-shell-burger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--shell-ink);
    border-radius: 1px;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  @media (max-width: 900px) {
    .eg-shell-burger { display: flex; }
    .eg-shell-nav {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--shell-bg);
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
      gap: 20px;
      display: none;
      margin-left: 0;
      border-top: 1px solid var(--shell-line);
    }
    .eg-shell-header.is-open .eg-shell-nav { display: flex; }
  }
</style>
