---
const uk = Astro.url.searchParams.get("lang") === "ua" || (Astro.url.searchParams.get("lang") !== "en" && Astro.cookies.get("lang")?.value === "ua");
const year = new Date().getFullYear();
---

<footer class="eg-shell-footer">
  <div class="eg-footer-brand">
    <a href="/"><img src="/branding/entinygram-mark.svg" alt="" width="38" height="38" />entinyGram</a>
    <span data-lang-key="eg_footer_note">{uk ? "Незалежний патчсет для Telegram Android." : "An independent Telegram Android patchset."}</span>
  </div>
  <nav aria-label="entinyGram footer navigation">
    <a href="/features" data-lang-key="eg_nav_features">Features</a>
    <a href="/changelog" data-lang-key="eg_nav_changelog">Changelog</a>
    <a href="/faq" data-lang-key="eg_nav_faq">FAQ</a>
    <a href="/docs" data-lang-key="eg_nav_docs">Docs</a>
    <a href="/branding">{uk ? "Брендинг" : "Branding"}</a>
    <a href="/build">{uk ? "Збірка" : "Build"}</a>
    <a href="/downloads" data-lang-key="eg_nav_download">Downloads</a>
    <a href="/donate" style="color:var(--shell-accent); font-weight:500;" data-lang-key="eg_nav_donate">Support</a>
    <a href="https://github.com/entaytion/entinyGram" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </nav>
  <small>© {year} entinyGram</small>
</footer>

<style is:global>
  .eg-shell-footer {
    --shell-ink:var(--clr-text);
    --shell-muted:var(--clr-text-muted);
    --shell-accent:var(--clr-link);
    --shell-line:var(--clr-border);
    max-width: 1320px;
    min-height: 96px;
    margin: 0 auto;
    padding: 38px 4vw;
    border-top: 1px solid var(--shell-line);
    display: grid;
    grid-template-columns: minmax(160px, 1fr) 2fr auto;
    align-items: start;
    gap: 28px;
    color: var(--shell-muted);
    font-family: var(--font-main, "Overused Grotesk", sans-serif);
  }
  .eg-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-right: auto;
  }
  .eg-footer-brand > a {
    display: flex;
    align-items: center;
    gap: 3px;
    color: var(--shell-ink);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .eg-footer-brand > span {
    font-size: .9rem;
  }
  .eg-shell-footer nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .eg-shell-footer nav a {
    color: var(--shell-muted);
    text-decoration: none;
    font-size: .94rem;
    font-weight: 500;
  }
  .eg-shell-footer nav a:hover {
    color: var(--shell-accent);
  }
  .eg-shell-footer > small {
    font-size: 0.78rem;
  }
  @media (max-width: 640px) {
    .eg-shell-footer {
      padding: 24px 6vw;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .eg-footer-brand {
      width: 100%;
    }
    .eg-shell-footer nav {
      gap: 14px;
    }
  }
</style>
